library(tidyverse)
library(tidymodels)
gapminder_2025<-read_csv("gapminder_2025.csv")
gapminder_2025 |>
ggplot(mapping=aes(x=log_gdp, y=life_exp, color=world_4region))+
geom_point()+
labs(title="Life Expectancy vs.  GDP per capita by country for 2025", x="GDP per capita", y="Years", color="World Region")
gapminder_2025 |>
ggplot(mapping=aes(x=log_gdp, y=life_exp, color=world_4region))+
geom_point()+
facet_wrap(~world_4region)+
guides(color="none")+ #gets rid of color legend
labs(title="Life Expectancy vs. Logged GDP per capita by country for 2025", x="Log(GDP per capita)", y="Years")
firstmultiv=gapminder_2025|>
lm(life_exp~log_gdp+world_4region, data= _) #base R code, the _ tells R where to pipe
firstmultiv
plot(firstmultiv, which = 1)
plot(firstmultiv, which = 2)
summary(firstmultiv)
gapminder_2025 |>
ggplot(mapping=aes(x=log_gdp, y=life_exp, color=world_4region))+
geom_point()+
geom_smooth(method="lm", se=0)+
labs(title="Life Expectancy vs.  GDP per capita by country for 2025", x="GDP per capita", y="Years", color="World Region")
gapminder_2025 |>
ggplot(mapping=aes(x=log_gdp, y=life_exp, color=world_4region))+
geom_point()+
geom_smooth(method="lm", se=0)+
facet_wrap(~world_4region)+
guides(color="none")+ #gets rid of color legend
labs(title="Life Expectancy vs. Logged GDP per capita by country for 2025", x="Log(GDP per capita)", y="Years")
Full_2025 |>
ggplot(aes(x = HumDevIndx, y = life_Exp, color = world_4region)) +
geom_point() +
geom_smooth(method = "lm", se = FALSE) +
labs(
x = "Human Development Index",
y = "Life Expectancy at Birth",
color = "World Region",
title = "Life Expectancy vs. Human Development Index by Region"
)
