#Add libraries as needed
library(tidyverse)
library(tidymodels)
# Load you data, NOVA.csv. Make sure to name it NOVA.
# read in original dataset
NOVA <- read_csv("NOVA.csv")
# copy the NOVA dataset to NOVA2
NOVA2 <- NOVA
# Display to ensure the copy matches the original
head(NOVA)
head(NOVA2)
NOVA2 |>
group_by(CountySchool) |>
summarize(property_count = n())
#Create histogram of Prices and highlight outliers
ggplot(data = NOVA2, mapping = aes(x = Price)) +
geom_histogram(binwidth = 200000, color = "black", fill = "lightblue") +
labs(x = "Price (in Dollars)",
y = "Number of Properties") +
scale_x_continuous(labels = scales::comma) + #Removes scientific notation from axis labels
geom_vline(xintercept = 3000000, color = "red", linewidth = 2) +
geom_point(data = NOVA2[NOVA2$Price > 3000000,],aes(x = Price, y = 0),
color = "red", shape = 1, size = 10)
outlier_props <- NOVA2 |>
filter(Price > 3000000) |>
arrange(desc(Price)) # arrange price highest to lowest
outlier_props
NOVA2 <- NOVA2 |>
filter(Price < 3000000,
grepl("FAIRFAX|ARLINGTON", CountySchool))
NOVA2
1052-13
NOVA2 <- NOVA2 |> #create the log variable
mutate(logPrice = log(Price))
#Create histogram of logPrice
ggplot(data = NOVA2, mapping = aes(x = logPrice)) +
geom_histogram(binwidth = 0.2, color = "black", fill = "lightblue") +
labs(x = "logPrice",
y = "Number of Properties") +
scale_x_continuous(labels = scales::comma)  #Removes scientific notation from axis labels
NOVA2 <- NOVA2 |>
mutate(Single = if_else(grepl("Single", ListingType), 1,0),
Arlington = if_else(grepl("ARLINGTON", CountySchool), 1,0))
# Double check work by finding mean of logPrice and mean of Arlington
NOVA2 |>
summarize(avg_logPrice = mean(logPrice, na.rm=TRUE),
avg_Arlington = mean(Arlington, na.rm=TRUE))
NOVA2
write_csv(NOVA2, "nova2.csv")
