summarize(avg_CO2 = mean(CO2),
sd_CO2 = sd(CO2),
min_CO2 = min(CO2),
max_CO2 = max(CO2),
mdn_CO2 = median(CO2),
iqr = IQR(CO2),
sample_size = n())
